<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run on a dedicated MySQL database. NOTE: MySQL has no RLS, so
             tenant isolation is enforced by the application-level BelongsToTenant
             scope only — the cross-tenant leak test is the sole guard.
             Override via env in CI. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="elameed_test"/>
        <env name="DB_USERNAME" value="elameed_app"/>
        <env name="DB_PASSWORD" value="elameed_app_secret"/>
        <env name="DB_URL" value=""/>
        <!-- Tenancy hosts are pinned here so the suite's hard-coded example
             hosts stay valid even if the deployment default moves again. Keep
             these in step with the hosts the Tenancy/PlatformAdmin tests use. -->
        <env name="TENANCY_BASE_DOMAIN" value="edu.raqeem-tech.com"/>
        <env name="TENANCY_CENTRAL_DOMAINS" value="admin.edu.raqeem-tech.com"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Paymob sandbox stand-ins: every test that reaches the gateway fakes
             the HTTP call, so these only need to be present. -->
        <env name="PAYMOB_SECRET_KEY" value="test-secret-key"/>
        <env name="PAYMOB_PUBLIC_KEY" value="test-public-key"/>
        <env name="PAYMOB_INTEGRATION_IDS" value="1111"/>
        <env name="FAWRY_MERCHANT_CODE" value="test-merchant"/>
        <env name="FAWRY_SECURE_KEY" value="test-secure-key"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
