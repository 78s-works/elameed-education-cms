# ── Elameed Education API — PRODUCTION environment template ─────────────────
#
# Copy to `.env` ON THE SERVER (this repo's .gitignore keeps `.env` and
# `.env.production` out of git) and fill the secrets. After ANY change run:
#
#   php artisan config:clear && php artisan config:cache
#
# Platform hosts (raqeem-tech.com):
#   SPA  → https://front.edu.raqeem-tech.com
#   API  → https://back.edu.raqeem-tech.com   (this app)
#
APP_NAME="Elameed Education"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://back.edu.raqeem-tech.com

# Demo data (both demo academies) stays off production. `php artisan db:seed`
# here creates the permission/role/notification catalogs and nothing else.
# Set to true ONLY for a deliberate demo on a throwaway database.
SEED_DEMO=false
# Paymob (Accept). Sandbox and live differ ONLY by these credentials — the live
# flip is this env edit, no deploy. Keys come from the Paymob dashboard and stay
# out of the database and the logs.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Integration ids of the methods on the checkout (card, wallet, kiosk…).
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL=https://back.edu.raqeem-tech.com/api/v1/webhooks/paymob
# PAYMOB_REDIRECTION_URL=https://front.edu.raqeem-tech.com/checkout/return

# Fawry (cash at an outlet). Live host + the live merchant credentials; the
# reference expiry must match what the merchant account allows.
FAWRY_BASE_URL=https://www.atfawry.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_EXPIRY_HOURS=72

# Browser origins allowed to call the API (exact scheme+host, comma-separated).
# The SPA origin is required; add each teacher CUSTOM domain that serves the SPA
# on its own host (a teacher without a custom domain rides the shared front host
# via `?tenant=<slug>` and needs no extra entry here).
CORS_ALLOWED_ORIGINS=https://front.edu.raqeem-tech.com

# --- Multi-tenancy hosts (see config/tenancy.php) ---
# Tenants are reached at <slug>.<base_domain> unless they have a custom domain
# row in `tenant_domains`.
TENANCY_BASE_DOMAIN=edu.raqeem-tech.com

# Central/platform hosts, exempt from the tenant host gate. `back` must be listed
# because EVERY API request arrives on it; `front` is the SPA host that unlocks
# the /admin/* console client-side.
TENANCY_CENTRAL_DOMAINS=back.edu.raqeem-tech.com,front.edu.raqeem-tech.com

# REQUIRED for the split front/back deployment. The API is reached on a single
# central host (back.edu.raqeem-tech.com), so the Host header never identifies a
# tenant — the SPA sends the tenant in `X-Tenant` instead (resolved from its own
# host, or from `?tenant=<slug>` on the shared front deployment). Without this,
# `config/tenancy.php` disables the header on APP_ENV=production and every
# tenant-scoped route answers "No tenant resolved".
# Trade-off: any caller may then name a tenant via this header. That is safe here
# because the header only SELECTS a tenant — it grants no access: authorization
# still runs off the Sanctum token's own tenant membership.
TENANCY_ALLOW_HEADER_OVERRIDE=true

# CNAME target handed to a teacher onboarding a custom domain. Point this record
# at the SPA origin (or the Cloudflare-for-SaaS fallback hostname).
DOMAINS_CNAME_TARGET=connect.edu.raqeem-tech.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Auth is Sanctum BEARER tokens, not cookies — leave this null. Front and back
# are separate hosts, so a shared cookie domain buys nothing.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@raqeem-tech.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Media provider: local (project storage) | remote (OVH Media Host).
# Keep in sync with the SPA's own VITE_MEDIA_PROVIDER.
MEDIA_PROVIDER=local
MEDIA_DISK=
FFMPEG_BIN=

MEDIA_HOST_BASE_URL=
MEDIA_HOST_API_KEY=
MEDIA_HOST_API_SECRET=
MEDIA_HOST_CALLBACK_SECRET=
MEDIA_HOST_PLAYBACK_PRIVATE_KEY_PATH=
MEDIA_HOST_PLAYBACK_PUBLIC_KEY_PATH=
MEDIA_HOST_CONNECT_TIMEOUT=
MEDIA_HOST_REQUEST_TIMEOUT=
MEDIA_HOST_UPLOAD_SESSION_TTL=
MEDIA_HOST_PLAYBACK_TOKEN_TTL=
MEDIA_HOST_MAX_UPLOAD_BYTES=
MEDIA_HOST_VERIFY_SSL=true
