<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS config for Plesk on Windows. The repo also ships public/.htaccess for
     Apache; IIS ignores that file, so without this one the site runs on
     whatever defaults Plesk generated.

     WHY THIS EXISTS: with the stock Plesk/IIS defaults the WebDAV module is
     loaded and claims PUT, PATCH and DELETE before PHP ever runs, answering an
     IIS HTML "403 - Forbidden: Access is denied." page. Reads and logins work
     (GET/POST are untouched), so the API looks healthy while every save, edit
     and delete in both panels fails. The SPA maps any 403 to its generic
     "you do not have permission" message, so the symptom reads as a broken
     permission system rather than a blocked HTTP verb.

     Verify with: curl -i -X OPTIONS https://<api-host>/api/v1/teacher/profile
     A correct server does NOT list a short `Allow:` header of
     "OPTIONS, TRACE, GET, HEAD, POST" — the write verbs must reach Laravel. -->
<configuration>
  <system.webServer>

    <!-- 1) Take WebDAV out of the pipeline. Both halves are required: the
         MODULE intercepts the request, the HANDLER claims the verbs. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- 2) Let every verb through request filtering, and allow the request
         bodies the API needs (uploads are capped by PHP/Laravel, not here).
         TRACE stays off: it is never needed and is a known XST vector. -->
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <remove verb="TRACE" />
          <add verb="TRACE" allowed="false" />
        </verbs>
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- 3) Laravel front controller: anything that is not a real file or
             directory is handled by index.php.

             NOTE: no rule re-exposes HTTP_AUTHORIZATION here, unlike
             public/.htaccess. Setting a server variable requires it to be
             whitelisted in applicationHost.config, which Plesk does not permit
             by default — IIS answers HTTP 500.50 for the whole site if it is
             not. Bearer tokens already reach Laravel on this host, so the rule
             would be pure risk. Only add it if Authorization actually goes
             missing, and whitelist the variable first. -->
        <rule name="Laravel front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
