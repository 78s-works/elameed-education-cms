<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS configuration for the API host (back.edu.raqeem-tech.com, Plesk/Windows).

     public/.htaccess is the Apache half of this; IIS ignores it, so without this
     file the deployment depends on a hand-written server config, and IIS defaults
     silently kill every browser call from the SPA.

     THE BUG THIS FILE FIXES (CORS preflight blocked)

     The SPA on front.edu.raqeem-tech.com (and teacher domains such as
     ahmedtammam.com) calls the API cross-origin, so the browser sends a CORS
     preflight (an OPTIONS request) before the real GET/POST. On this host that
     preflight failed with "No 'Access-Control-Allow-Origin' header", while the
     real GET/POST came back with the header set correctly.

     Two IIS layers sit in front of PHP, and each had to be cleared:

       1. IIS ships an OPTIONSVerbHandler that answers every OPTIONS request
          itself before PHP runs. Removing it (below) lets the rewrite route
          OPTIONS onward.

       2. After that, OPTIONS reaches the URL Rewrite and is handed to
          index.php - but the Plesk PHP FastCGI handler mapping is NOT
          registered for the OPTIONS verb, so IIS answers 405 Method Not Allowed
          (Allow: GET, HEAD, OPTIONS, TRACE - the static-file handler's verb
          set, proof PHP never ran). Laravel's HandleCors therefore never sees
          the preflight.

     Because we cannot rely on the Plesk-managed PHP FastCGI mapping accepting
     OPTIONS - and editing that mapping risks a 500.19 for the whole site - the
     preflight is answered INSIDE IIS instead:

       - An inbound rewrite rule short-circuits any OPTIONS request to an empty
         204 response (PHP is never invoked).
       - Outbound rules attach the CORS headers to that 204, reflecting the
         request Origin ({HTTP_ORIGIN}) and the requested headers
         ({HTTP_ACCESS_CONTROL_REQUEST_HEADERS}).

     The REAL GET/POST/PUT/... requests are untouched: they still reach PHP and
     Laravel's HandleCors, which enforces the true origin allow-list in
     config/cors.php. Reflecting the origin on the *preflight* only is safe -
     the preflight carries no data, and a disallowed origin still gets no CORS
     header on the real response, so the browser blocks reading it anyway. Auth
     is Sanctum bearer tokens (supports_credentials=false), so no
     Access-Control-Allow-Credentials header is emitted and reflecting a specific
     origin is correct.

     Notes for whoever deploys this:
       - If a hand-made web.config already exists in the document root, MERGE
         these sections into it rather than replacing it; Plesk sometimes keeps
         the site's PHP FastCGI handler mapping there.
       - Only handlers that IIS defines globally are removed here. Do NOT add
         `<remove name="WebDAV" />` / `<remove name="WebDAVModule" />` unless
         WebDAV is actually installed on the host: removing an entry that does
         not exist makes IIS answer 500.19 for the whole site. (This host is not
         running WebDAV: its OPTIONS reply carries no `DAV:` header.)
       - Verbs are also filtered ABOVE IIS on this host: Plesk's ModSecurity
         ruleset 403s PUT/PATCH/DELETE ("403 ModSecurity Action"), which breaks
         every teacher/admin write. That is a Plesk ModSecurity setting, not
         something this file can override. -->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
    </handlers>

    <security>
      <requestFiltering>
        <!-- Explicit allow-list, so a parent config with allowUnlisted="false"
             cannot drop the verbs the API needs. -->
        <verbs>
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- CORS preflight: answer OPTIONS in IIS with an empty 204, before the
             front controller, because the PHP FastCGI handler on this host does
             not accept the OPTIONS verb (it would 405). The CORS headers are
             added by the outbound rules below. -->
        <rule name="CORS preflight (OPTIONS) short-circuit" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
          </conditions>
          <action type="CustomResponse" statusCode="204" statusReason="No Content" />
        </rule>

        <!-- Mirror of .htaccess: existing files and directories are served as
             they are, everything else goes to the Laravel front controller. -->
        <rule name="Serve existing files and directories" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Laravel front controller" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>

      <!-- Attach the CORS headers to the 204 preflight response. These run ONLY
           for OPTIONS requests that carry an Origin (the preConditions), so the
           real GET/POST responses keep the headers Laravel's HandleCors sets and
           are never touched here. Setting a RESPONSE_* server variable creates
           the header if it is absent. -->
      <outboundRules>
        <preConditions>
          <preCondition name="IsCorsPreflight">
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
            <add input="{HTTP_ORIGIN}" pattern=".+" />
          </preCondition>
        </preConditions>

        <rule name="CORS preflight - Allow-Origin" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Origin" pattern=".*" />
          <action type="Rewrite" value="{HTTP_ORIGIN}" />
        </rule>
        <rule name="CORS preflight - Allow-Methods" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Methods" pattern=".*" />
          <action type="Rewrite" value="GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" />
        </rule>
        <rule name="CORS preflight - Allow-Headers" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Headers" pattern=".*" />
          <action type="Rewrite" value="{HTTP_ACCESS_CONTROL_REQUEST_HEADERS}" />
        </rule>
        <rule name="CORS preflight - Max-Age" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Max-Age" pattern=".*" />
          <action type="Rewrite" value="600" />
        </rule>
        <rule name="CORS preflight - Vary" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Origin" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Deploy marker: lets a request to this host prove WHICH revision of this
         file the server is actually running, so a config fix can be verified
         from outside without shell access. Bump the value with every change. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Elameed-Webconfig" value="r3" />
      </customHeaders>
    </httpProtocol>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
