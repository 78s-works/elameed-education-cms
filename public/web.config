<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <remove name="Access-Control-Allow-Origin" />

        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, PATCH, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Authorization, Content-Type, Accept, X-Tenant,x-academic-year, X-Requested-With, Origin" />
        <add name="Access-Control-Max-Age" value="3600" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <outboundRules>
        <rule name="Allow selected CORS origins">
          <match serverVariable="RESPONSE_Access_Control_Allow_Origin" pattern=".*" />

          <conditions logicalGrouping="MatchAll">
  <add input="{HTTP_ORIGIN}" pattern="^https://((front\.edu|teacher1\.edu|teacher2\.edu|dr-ahmed-tammam)\.raqeem-tech\.com|ahmedtammam\.com|test.ahmedtammam\.com|mohamed.edu.raqeem-tech\.com)$" />
</conditions>

          <action type="Rewrite" value="{HTTP_ORIGIN}" />
        </rule>
      </outboundRules>
    </rewrite>
        <handlers>
            <remove name="PHP-php" />
            <add name="PHP-php" path="*.php" verb="GET,HEAD,POST,PUT,DELETE,PATCH" modules="FastCgiModule" scriptProcessor="C:\Program Files (x86)\Plesk\Additional\PleskPHP84\php-cgi.exe|-d siteId=67" resourceType="Either" requireAccess="Script" />
        </handlers>

  </system.webServer>
</configuration>

