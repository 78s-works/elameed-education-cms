<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS configuration for the API host (back.edu.raqeem-tech.com, Plesk/Windows).

     public/.htaccess is the Apache half of this; IIS ignores it, so without this
     file the deployment depends on a hand-written server config, and one IIS
     default silently kills the whole SPA:

       IIS ships an OPTIONSVerbHandler that answers every OPTIONS request
       itself (200, `Allow:` + `Public:` headers, empty body) before PHP runs.
       CORS preflights are OPTIONS requests, so Laravel's HandleCors never sees them
       and no Access-Control-Allow-Origin comes back, even though the real
       GET/POST returns it correctly. Every browser call from
       front.edu.raqeem-tech.com and from teacher domains is therefore blocked
       at the preflight with "No 'Access-Control-Allow-Origin' header".

     Removing that handler lets the rewrite below hand OPTIONS to index.php,
     where HandleCors (and DynamicTenantCors ahead of it) answer the preflight.

     Notes for whoever deploys this:
       - If a hand-made web.config already exists in the document root, MERGE
         these sections into it rather than replacing it; Plesk sometimes keeps
         the site's PHP FastCGI handler mapping there.
       - Only handlers that IIS defines globally are removed here. Do NOT add
         `<remove name="WebDAV" />` / `<remove name="WebDAVModule" />` unless
         WebDAV is actually installed on the host: removing an entry that does
         not exist makes IIS answer 500.19 for the whole site. (This host is not
         running WebDAV: its OPTIONS reply carries no `DAV:` header.)
       - Verbs are also filtered ABOVE IIS on this host: Plesk's ModSecurity
         ruleset 403s PUT/PATCH/DELETE ("403 ModSecurity Action"), which breaks
         every teacher/admin write. That is a Plesk ModSecurity setting, not
         something this file can override. -->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
    </handlers>

    <security>
      <requestFiltering>
        <!-- Explicit allow-list, so a parent config with allowUnlisted="false"
             cannot drop the verbs the API needs. -->
        <verbs>
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Mirror of .htaccess: existing files and directories are served as
             they are, everything else goes to the Laravel front controller. -->
        <rule name="Serve existing files and directories" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Laravel front controller" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
