<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS configuration for the API host (back.edu.raqeem-tech.com, Plesk/Windows).

     SCOPE: this file is deliberately MINIMAL. Every previous version that added
     rewrite rules or removed handlers replaced Plesk's own working request
     routing and broke CORS (the SPA went fully dark with "No
     'Access-Control-Allow-Origin' header"). This version touches NONE of that.
     It leaves Plesk's inbound routing and handler mappings exactly as they are
     and only adds response-header decoration.

     THE PROBLEM
     With no web.config, IIS's built-in OPTIONSVerbHandler answers every CORS
     preflight (an OPTIONS request) itself with "200 OK" and an `Allow:` header,
     before PHP runs. That 200 is fine except it carries no
     Access-Control-Allow-Origin, so the browser rejects the preflight and
     blocks the whole SPA. The real GET/POST requests DO reach Laravel and its
     HandleCors returns the header correctly (verified with curl) - only the
     preflight is missing it.

     THE FIX
     Outbound rewrite rules add the CORS headers onto that existing 200
     response. They are gated by a preCondition to OPTIONS requests that carry
     an Origin, so the real GET/POST responses are never touched and keep the
     header Laravel already sets (no duplicate Access-Control-Allow-Origin).
     Setting a RESPONSE_* server variable creates the header when it is absent.
     The origin is reflected from the request ({HTTP_ORIGIN}); auth is Sanctum
     bearer tokens (supports_credentials=false), so reflecting a specific origin
     is correct and no credentials header is emitted. The true origin allow-list
     is still enforced by config/cors.php on the real responses.

     Write verbs (PUT/PATCH/DELETE) are a SEPARATE issue (IIS WebDAV / Plesk
     ModSecurity claim them before PHP). That is fixed at the server, not here,
     precisely so this file never has to touch routing again. -->
<configuration>
  <system.webServer>
    <rewrite>
      <outboundRules>
        <preConditions>
          <preCondition name="IsCorsPreflight">
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
            <add input="{HTTP_ORIGIN}" pattern=".+" />
          </preCondition>
        </preConditions>

        <rule name="CORS preflight - Allow-Origin" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Origin" pattern=".*" />
          <action type="Rewrite" value="{HTTP_ORIGIN}" />
        </rule>
        <rule name="CORS preflight - Allow-Methods" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Methods" pattern=".*" />
          <action type="Rewrite" value="GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" />
        </rule>
        <rule name="CORS preflight - Allow-Headers" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Allow-Headers" pattern=".*" />
          <action type="Rewrite" value="{HTTP_ACCESS_CONTROL_REQUEST_HEADERS}" />
        </rule>
        <rule name="CORS preflight - Max-Age" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Access-Control-Max-Age" pattern=".*" />
          <action type="Rewrite" value="600" />
        </rule>
        <rule name="CORS preflight - Vary" preCondition="IsCorsPreflight">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Origin" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Deploy marker: proves which revision of this file the server is running. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Elameed-Webconfig" value="r4" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
